# SQL Server
SA_PASSWORD=YourStrong!Passw0rd

# AI Service shared API key (used by both backend-api and ai-service)
AI_SERVICE_API_KEY=dev-api-key-change-me

# LLM Provider: "azure", "groq", or "ollama"
LLM_PROVIDER=ollama

# Azure OpenAI (used when LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# Groq (used when LLM_PROVIDER=groq — free tier for testing)
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (used when LLM_PROVIDER=ollama — runs locally, no API key needed)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3.5:4b
