# Goldset for RAG retrieval evaluation. JSON Lines format — one query per line.
# Lines starting with `#` and blank lines are ignored.
#
# Schema (see app/evals/goldset.py for validation):
#   id:                    string, unique
#   query:                 string, the user question
#   language:              "fr" | "ar" | "en"
#   intent:                "definition" | "procedure" | "list" | "comparison" | "lookup" | "multi_hop"
#   relevant_segment_ids:  list[string] — TextSegment.VectorStoreId values that should rank
#   reference_answer:      string, optional, used by the LLM-as-judge
#   notes:                 string, optional, free-form context
#
# ─────────────────────────────────────────────────────────────────────────────
# DISPOSABLE STARTER SET (LLM-drafted, 2026-05-19).
# Drafted from the two richest test docs:
#   D1 = normes_technique.pdf          (Arrêté marocain 902-08 — normes officines/établissements)
#   D2 = partie_i-chapitre_4frdef.pdf  (BPF Chapitre 4 — Documentation)
#
# `relevant_segment_ids` is "PENDING" everywhere: chunk ids only exist after
# ingestion. Resolve them with `python -m app.evals.bootstrap` (re-search each
# query, pick the matching chunk) OR rebuild on the real corpus when it lands.
# `notes` records the source article so the id-resolution pass is fast.
#
# NOTE: load_goldset() ACCEPTS these lines (["PENDING"] is a valid non-empty
# list), but every query will score 0.0 because no chunk has VectorStoreId
# "PENDING". Treat this as a question bank, not a runnable eval, until the id
# pass replaces "PENDING" with real VectorStoreIds.
#
# This set is a PIPELINE REHEARSAL + REGRESSION SCAFFOLD only. It is NOT a
# calibration goldset — do not make prod go/no-go decisions on these numbers.
# ─────────────────────────────────────────────────────────────────────────────
{"id": "q-d2-001", "query": "Quelle est la durée minimale de conservation des dossiers de lot selon les BPF ?", "language": "fr", "intent": "lookup", "relevant_segment_ids": ["bb0b6a4e-9ce5-49d3-a3a4-a08abebf5e08"], "reference_answer": "Les dossiers de lot doivent être conservés au moins un an après la date de péremption du lot correspondant, ou au moins cinq ans après la certification du lot par la personne qualifiée, le délai le plus long s'appliquant.", "notes": "D2 §4.11 | resolved: rank1/ov1.00"}
{"id": "q-d2-002", "query": "Pendant combien de temps conserve-t-on les dossiers de lot des médicaments expérimentaux ?", "language": "fr", "intent": "lookup", "relevant_segment_ids": ["bb0b6a4e-9ce5-49d3-a3a4-a08abebf5e08"], "reference_answer": "Au moins cinq ans après l'achèvement ou l'interruption formelle du dernier essai clinique au cours duquel le lot a été utilisé.", "notes": "D2 §4.11 | resolved: rank1/ov0.75"}
{"id": "q-d2-003", "query": "Qu'est-ce qu'une procédure opératoire standardisée (SOP) selon les BPF ?", "language": "fr", "intent": "definition", "relevant_segment_ids": ["6a01a54b-744a-499a-a6e4-ebb2a3fe1323"], "reference_answer": "Une procédure (également appelée procédure opératoire standardisée ou SOP) donne les indications nécessaires à la réalisation de certaines opérations.", "notes": "D2 — Procédures | resolved: rank1/ov0.55"}
{"id": "q-d2-004", "query": "Que doit contenir un certificat d'analyse ?", "language": "fr", "intent": "definition", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "Un certificat d'analyse fournit un résumé de l'ensemble des résultats des contrôles réalisés sur les échantillons de produits ou de matériels, ainsi qu'une évaluation de leur conformité aux spécifications établies.", "notes": "D2 — Certificats d'analyse | resolved: best_overlap=0.18<thr=0.45 (rank3)"}
{"id": "q-d2-005", "query": "Quels sont les deux principaux types de documents utilisés pour gérer la conformité aux BPF ?", "language": "fr", "intent": "definition", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "Les instructions (consignes et exigences) et les enregistrements/rapports.", "notes": "D2 — Principe | resolved: best_overlap=0.40<thr=0.45 (rank3)"}
{"id": "q-d2-006", "query": "Quelles informations doit comporter un dossier de fabrication de lot ?", "language": "fr", "intent": "list", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "Notamment : nom et numéro de lot du produit ; dates/heures de production ; initiales des opérateurs des étapes critiques ; quantités de chaque matière première pesée ; opérations et équipements ; relevé des contrôles en cours de fabrication ; rendements ; notes sur les déviations autorisées ; approbation par la personne responsable.", "notes": "D2 §4.20 | resolved: best_overlap=0.29<thr=0.32 (rank1)"}
{"id": "q-d2-007", "query": "Que doivent comporter les spécifications des matières premières et articles de conditionnement ?", "language": "fr", "intent": "list", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "Description (nom interne et code, référence pharmacopée, fournisseurs agréés, spécimen des articles imprimés) ; instructions d'échantillonnage et de contrôle ; caractéristiques qualitatives/quantitatives avec limites d'acceptation ; conditions et précautions de stockage ; durée maximale de stockage avant recontrôle.", "notes": "D2 §4.14 | resolved: best_overlap=0.27<thr=0.32 (rank1)"}
{"id": "q-d2-008", "query": "Comment doit-on traiter une correction apportée à un document BPF ?", "language": "fr", "intent": "procedure", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "Toute correction doit être signée et datée, et permettre la lecture de la mention originale ; le cas échéant, le motif de la correction doit être noté.", "notes": "D2 §4.9 | resolved: best_overlap=0.23<thr=0.40 (rank10)"}
{"id": "q-d2-009", "query": "À quel moment les enregistrements doivent-ils être effectués pendant la fabrication ?", "language": "fr", "intent": "lookup", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "Au moment où chaque action est réalisée, de telle sorte que toutes les opérations significatives concernant la fabrication des médicaments puissent être tracées.", "notes": "D2 §4.8 | resolved: best_overlap=0.33<thr=0.45 (rank7)"}
{"id": "q-d2-010", "query": "Pour quelles activités des procédures écrites sont-elles exigées par les BPF ?", "language": "fr", "intent": "list", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "Notamment : validations/qualifications, étalonnage, transferts de technologie, entretien/nettoyage/désinfection, personnel et formation, surveillance de l'environnement, lutte contre les nuisibles, réclamations, rappels, retours, maîtrise des changements, investigations des déviations, audits qualité internes, revues qualité produit, audits fournisseurs.", "notes": "D2 §4.29 | resolved: best_overlap=0.10<thr=0.32 (rank1)"}
{"id": "q-d2-011", "query": "Quelle est la différence entre un dossier de fabrication de lot et un dossier de conditionnement de lot ?", "language": "fr", "intent": "comparison", "relevant_segment_ids": ["ad25470a-e56f-486a-a379-e81c43962d0e", "6a01a54b-744a-499a-a6e4-ebb2a3fe1323"], "reference_answer": "Le dossier de fabrication de lot (§4.20) est basé sur la formule et les instructions de fabrication et trace la production. Le dossier de conditionnement de lot (§4.21) est basé sur les instructions de conditionnement et trace les opérations de conditionnement (équipements/lignes utilisés, articles imprimés, réconciliation des quantités).", "notes": "D2 §4.20 vs §4.21 — multi-chunk | resolved: multi:rank1/ov0.25, rank2/ov0.25"}
{"id": "q-d2-012", "query": "Quelles sont les règles d'archivage des documents autres que les dossiers de lot ?", "language": "fr", "intent": "multi_hop", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "Leur durée d'archivage dépend de l'activité associée. Les documents essentiels contenant des données brutes en appui de l'AMM doivent être archivés tant que l'AMM reste en vigueur ; un retrait est acceptable une fois les données remplacées par un ensemble complet de nouvelles données, en tenant compte des exigences propres aux dossiers de lot.", "notes": "D2 §4.11+§4.12 — multi_hop | resolved: best_overlap=0.23<thr=0.25 (rank1)"}
{"id": "q-d2-013", "query": "What is the minimum retention period for batch records under GMP?", "language": "en", "intent": "lookup", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "At least one year after the batch expiry date, or at least five years after batch certification by the qualified person, whichever is longer.", "notes": "D2 §4.11 — EN | resolved: best_overlap=0.15<thr=0.45 (rank1)"}
{"id": "q-d2-014", "query": "What records must a batch packaging record contain?", "language": "en", "intent": "list", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "Product name and batch number; packaging dates/times; operator identification for critical steps; checks on identity and conformity to packaging instructions; equipment/lines used; samples of printed packaging where possible; notes on deviations; quantities and reconciliation of printed packaging materials and bulk product; approval by the responsible person.", "notes": "D2 §4.21 — EN | resolved: best_overlap=0.06<thr=0.32 (rank2)"}
{"id": "q-d2-015", "query": "ما هي المدة الدنيا للاحتفاظ بملفات الدفعة وفقا لممارسات التصنيع الجيدة؟", "language": "ar", "intent": "lookup", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "سنة واحدة على الأقل بعد تاريخ انتهاء صلاحية الدفعة، أو خمس سنوات على الأقل بعد المصادقة على الدفعة من قبل الشخص المؤهل، ويُطبَّق الأجل الأطول.", "notes": "D2 §4.11 — AR | resolved: best_overlap=0.00<thr=0.45 (rank1)"}
{"id": "q-d1-001", "query": "Quelle est la superficie minimale d'un local devant abriter une officine de pharmacie ?", "language": "fr", "intent": "lookup", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "Supérieure ou égale à vingt-quatre (24) m² au sol.", "notes": "D1 Art. 2 | resolved: best_overlap=0.00<thr=0.45 (rank1)"}
{"id": "q-d1-002", "query": "Quels espaces une officine de pharmacie doit-elle obligatoirement comporter ?", "language": "fr", "intent": "list", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "Au moins : un espace d'accueil avec présentoir ; un espace pour rayonnages ; un préparatoire équipé d'un point d'eau ; un lieu de mise en quarantaine ; un lieu sécurisé pour les stupéfiants ; un bureau du pharmacien ; des sanitaires avec point d'eau distinct ; un lavabo avec point d'eau distinct.", "notes": "D1 Art. 5 | resolved: best_overlap=0.20<thr=0.32 (rank5)"}
{"id": "q-d1-003", "query": "En matière de stockage, de quels locaux un établissement pharmaceutique industriel doit-il disposer ?", "language": "fr", "intent": "list", "relevant_segment_ids": ["d42c1392-5754-4ff1-8a8a-bf06dd855093"], "reference_answer": "Lieux de réception et distribution ; quarantaine distincte (sauf système informatisé validé) ; stockage des produits finis ; produits thermolabiles ; produits refusés/rappelés/retournés ; produits périmés en attente de destruction ; matières premières et articles de conditionnement ; produits inflammables ; local ou armoires sécurisés pour les stupéfiants.", "notes": "D1 Art. 11 | resolved: rank2/ov0.59"}
{"id": "q-d1-004", "query": "Quelle est la superficie minimale des locaux d'un établissement pharmaceutique grossiste répartiteur ?", "language": "fr", "intent": "lookup", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "Au minimum cinq cents (500) m² au sol, à l'exclusion de la zone de stationnement des véhicules.", "notes": "D1 Art. 18 | resolved: best_overlap=0.00<thr=0.45 (rank1)"}
{"id": "q-d1-005", "query": "Quelles sont les normes d'aménagement des locaux d'un établissement pharmaceutique industriel en projet ?", "language": "fr", "intent": "list", "relevant_segment_ids": ["e7efe65a-c70b-45a0-b295-d69d2ff7837b"], "reference_answer": "Superficie adaptée à l'activité ; murs et plafonds recouverts de peinture, enduits spéciaux ou matériaux lisses et imperméables ; sol traité contre l'humidité et la poussière ; installation antidéflagrante.", "notes": "D1 Art. 10 | resolved: rank2/ov0.50"}
{"id": "q-d1-006", "query": "Que prévoit l'arrêté concernant les extincteurs dans une officine ?", "language": "fr", "intent": "lookup", "relevant_segment_ids": ["39aad513-df7e-4cdb-b75d-40ce84ce013d"], "reference_answer": "L'officine doit être dotée d'un extincteur, périodiquement contrôlé conformément à la législation et à la réglementation relative à la lutte contre l'incendie.", "notes": "D1 Art. 6 | resolved: rank4/ov0.71"}
{"id": "q-d1-007", "query": "Que doivent comporter les locaux de contrôle de la qualité d'un établissement industriel ?", "language": "fr", "intent": "list", "relevant_segment_ids": ["d42c1392-5754-4ff1-8a8a-bf06dd855093"], "reference_answer": "Un ou plusieurs laboratoires de contrôle distincts, et un lieu pour le stockage des échantillons et des dossiers.", "notes": "D1 Art. 12 | resolved: rank12/ov0.33"}
{"id": "q-d1-008", "query": "Que se passe-t-il lorsqu'un établissement pharmaceutique industriel comprend plusieurs sites de fabrication ?", "language": "fr", "intent": "lookup", "relevant_segment_ids": ["03b80436-b49a-488c-aef8-8ae9750faf86"], "reference_answer": "Tous les sites sont soumis aux mêmes normes techniques que le site principal et doivent être adaptés à la nature de l'activité qui s'y déroule, conformément aux règles de bonnes pratiques de fabrication.", "notes": "D1 Art. 16 | resolved: rank1/ov1.00"}
{"id": "q-d1-009", "query": "What is the minimum floor area required for a pharmacy under Moroccan regulation?", "language": "en", "intent": "lookup", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "Greater than or equal to twenty-four (24) m² of floor area.", "notes": "D1 Art. 2 — EN | resolved: best_overlap=0.00<thr=0.45 (rank1)"}
{"id": "q-d1-010", "query": "ما هي المساحة الدنيا للمحل الذي يأوي صيدلية؟", "language": "ar", "intent": "lookup", "relevant_segment_ids": ["NEEDS_HUMAN"], "reference_answer": "أكبر من أو تساوي أربعة وعشرين (24) مترا مربعا على مستوى الأرض.", "notes": "D1 Art. 2 — AR | resolved: best_overlap=0.00<thr=0.45 (rank1)"}
{"id": "q-x-001", "query": "Comparer les exigences de superficie minimale entre une officine de pharmacie et un établissement grossiste répartiteur.", "language": "fr", "intent": "comparison", "relevant_segment_ids": ["03b80436-b49a-488c-aef8-8ae9750faf86"], "reference_answer": "Une officine de pharmacie doit avoir au moins 24 m² au sol (Art. 2), tandis qu'un établissement pharmaceutique grossiste répartiteur doit disposer d'au minimum 500 m² au sol hors zone de stationnement (Art. 18).", "notes": "D1 Art. 2 vs Art. 18 — comparison multi-chunk | resolved: multi:rank1/ov0.33"}
{"id": "q-x-002", "query": "Comparer les lieux de stockage exigés pour un établissement industriel et pour un grossiste répartiteur.", "language": "fr", "intent": "comparison", "relevant_segment_ids": ["d42c1392-5754-4ff1-8a8a-bf06dd855093"], "reference_answer": "L'établissement industriel (Art. 11) exige notamment des lieux de réception/distribution, quarantaine, produits finis, thermolabiles, refusés/rappelés, périmés, matières premières, inflammables, stupéfiants. Le grossiste répartiteur (Art. 20) exige réception, quarantaine, aire de stockage, contrôle des livraisons, expédition, produits périmés, stupéfiants, produits retournés/avariés, conservation des thermolabiles, local téléphonistes.", "notes": "D1 Art. 11 vs Art. 20 — comparison multi-chunk | resolved: multi:rank1/ov0.43"}
{"id": "q-x-003", "query": "Quelles exigences documentaires des BPF s'appliquent à l'archivage des dossiers, et comment se comparent-elles aux exigences de locaux de stockage des dossiers dans un établissement industriel marocain ?", "language": "fr", "intent": "multi_hop", "relevant_segment_ids": ["bb0b6a4e-9ce5-49d3-a3a4-a08abebf5e08"], "reference_answer": "Les BPF (D2 §4.10–4.12) fixent les durées et l'intégrité d'archivage des enregistrements (dossiers de lot : ≥1 an après péremption ou ≥5 ans après certification). L'arrêté marocain (D1 Art. 12) exige côté locaux un lieu pour le stockage des échantillons et des dossiers dans la zone de contrôle qualité. Les deux sont complémentaires : l'un régit la durée/intégrité documentaire, l'autre l'infrastructure physique de stockage.", "notes": "D2 §4.10-4.12 + D1 Art. 12 — cross-doc multi_hop | resolved: multi:rank2/ov0.29"}
