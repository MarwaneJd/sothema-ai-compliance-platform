# API Security
AI_SERVICE_API_KEY=your-shared-api-key-here

# Database (SQL Server via ODBC)
AI_SERVICE_DATABASE_CONNECTION_STRING=mssql+aioodbc:///?odbc_connect=Driver={ODBC Driver 18 for SQL Server};Server=localhost,1433;Database=SothemaCompliance;UID=sa;PWD=YourStrong!Passw0rd;TrustServerCertificate=yes

# LLM Provider: "azure" or "groq"
AI_SERVICE_LLM_PROVIDER=groq

# Azure OpenAI (used when LLM_PROVIDER=azure)
AI_SERVICE_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AI_SERVICE_AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AI_SERVICE_AZURE_OPENAI_API_VERSION=2024-06-01
AI_SERVICE_AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# Groq (used when LLM_PROVIDER=groq — free tier for testing)
AI_SERVICE_GROQ_API_KEY=gsk_your-groq-api-key-here
AI_SERVICE_GROQ_MODEL=llama-3.3-70b-versatile

# Embedding (local sentence-transformers model — free, no API key needed)
AI_SERVICE_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
AI_SERVICE_EMBEDDING_DIMENSIONS=384

# FAISS
AI_SERVICE_FAISS_INDEX_PATH=data/faiss_indexes

# RAG Configuration
AI_SERVICE_CHUNK_SIZE=512
AI_SERVICE_CHUNK_OVERLAP=50
AI_SERVICE_RRF_K=60
AI_SERVICE_TOP_K_RESULTS=10

# Server
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_LOG_LEVEL=info
