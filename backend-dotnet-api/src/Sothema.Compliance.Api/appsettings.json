{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  "UseDevAuth": false,

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "YOUR_TENANT_ID",
    "ClientId": "YOUR_CLIENT_ID",
    "Audience": "api://YOUR_CLIENT_ID"
  },

  "SharePoint": {
    "TenantName": "yourtenant.sharepoint.com",
    "DefaultSiteId": ""
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=SothemaCompliance;User Id=sa;Password=YOUR_SA_PASSWORD;TrustServerCertificate=true"
  },

  "AiService": {
    "BaseUrl": "http://localhost:8000/",
    "ApiKey": ""
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
}
